{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "core:window:allow-hide",
    {
      "identifier": "shell:allow-execute",
      "allow": [{ "name": "helpers/calendar", "sidecar": true, "args": true }]
    }
  ]
}
